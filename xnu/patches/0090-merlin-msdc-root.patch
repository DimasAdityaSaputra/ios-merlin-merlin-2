diff --git a/bsd/dev/merlin_msdc.c b/bsd/dev/merlin_msdc.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/merlin_msdc.c
@@ -0,0 +1,837 @@
+/*
+ * MERLIN internal eMMC root device (read-only, fully polled).
+ *
+ * MERLIN = Redmi Note 9 (MT6768 / Helio G85). The OS image is dd'ed into the
+ * existing Android "userdata" GPT partition of the internal eMMC, exactly as
+ * the sweet port does with its UFS LUN. The bootloader (MTK LK) loaded our
+ * boot image from that eMMC, so the MSDC0 controller is already clocked, the
+ * card is already initialised (bus width, timing and pad tuning included) and
+ * left in the transfer state. This driver reuses that state: it takes the
+ * interrupt mask down, issues polled commands (CMD13/CMD16/CMD17/CMD18) and
+ * programmes the controller's own GPD/BD descriptor DMA into one physically
+ * contiguous bounce buffer.
+ *
+ * Nothing here depends on the platform timer or on GIC interrupts: every wait
+ * is an iteration-bounded register poll. That is deliberate - on merlin the
+ * kernel's first timeout-based wait (IOFindBSDRoot's gIOBSD match) never
+ * returns until the vtimer works, and this driver is reached before it, so
+ * rd=msdcroot0 can bring the iOS root up without any interrupt support.
+ *
+ * The device is exposed as the BSD disk msdcroot0 (rmsdcroot0), read-only,
+ * 512-byte logical sectors over the eMMC's native 512-byte sectors. Root on
+ * it with rd=msdcroot0 (IOKitBSDInit.cpp checks that before the gIOBSD wait).
+ *
+ * Boot args:
+ *   msdcprobe=1  print controller/card/GPT diagnostics and continue booting
+ *                without registering the root device (bring-up instrument).
+ *   msdcroot=NAME GPT partition to expose (default "userdata").
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/*--------------------------------------------------------------------------
+ * MSDC0 register map (drivers/mmc/host/mtk-sd.c of the device kernel source)
+ *------------------------------------------------------------------------*/
+#define MSDC_CFG                0x00
+#define MSDC_IOCON              0x04
+#define MSDC_PS                 0x08
+#define MSDC_INT                0x0c
+#define MSDC_INTEN              0x10
+#define MSDC_FIFOCS             0x14
+#define SDC_CFG                 0x30
+#define SDC_CMD                 0x34
+#define SDC_ARG                 0x38
+#define SDC_STS                 0x3c
+#define SDC_RESP0               0x40
+#define SDC_RESP1               0x44
+#define SDC_RESP2               0x48
+#define SDC_RESP3               0x4c
+#define SDC_BLK_NUM             0x50
+#define SDC_ADV_CFG0            0x64
+#define EMMC_IOCON              0x7c
+#define DMA_SA_H4BIT            0x8c
+#define MSDC_DMA_SA             0x90
+#define MSDC_DMA_CTRL           0x98
+#define MSDC_DMA_CFG            0x9c
+#define MSDC_PATCH_BIT          0xb0
+#define MSDC_PATCH_BIT1         0xb4
+#define MSDC_PATCH_BIT2         0xb8
+#define MSDC_PAD_TUNE           0xec
+#define MSDC_PAD_TUNE0          0xf0
+#define PAD_DS_TUNE             0x188
+#define PAD_CMD_TUNE            0x18c
+#define EMMC50_CFG0             0x208
+#define EMMC50_CFG3             0x220
+#define SDC_FIFO_CFG            0x228
+
+#define MSDC_CFG_PIO            (1u << 3)
+#define MSDC_CFG_CKSTB          (1u << 7)
+#define MSDC_CFG_CKDIV          (0xffu << 8)
+#define MSDC_CFG_CKMOD          (0x3u << 16)
+#define MSDC_CFG_HS400_CK_MODE  (1u << 18)
+
+#define MSDC_FIFOCS_RXCNT       (0xffu << 0)
+#define MSDC_FIFOCS_TXCNT       (0xffu << 16)
+
+#define SDC_CFG_BUSWIDTH        (0x3u << 16)
+#define SDC_CFG_DTOC            (0xffu << 24)
+
+#define SDC_STS_SDCBUSY         (1u << 0)
+#define SDC_STS_CMDBUSY         (1u << 1)
+#define SDC_STS_SWR_COMPL       (1u << 31)
+
+#define MSDC_INT_MMCIRQ         (1u << 0)
+#define MSDC_INT_CDSC           (1u << 1)
+#define MSDC_INT_ACMDRDY        (1u << 3)
+#define MSDC_INT_ACMDTMO        (1u << 4)
+#define MSDC_INT_ACMDCRCERR     (1u << 5)
+#define MSDC_INT_CMDRDY         (1u << 8)
+#define MSDC_INT_CMDTMO         (1u << 9)
+#define MSDC_INT_RSPCRCERR      (1u << 10)
+#define MSDC_INT_XFER_COMPL     (1u << 12)
+#define MSDC_INT_DXFER_DONE     (1u << 13)
+#define MSDC_INT_DATTMO         (1u << 14)
+#define MSDC_INT_DATCRCERR      (1u << 15)
+#define MSDC_INT_DMA_BDCSERR    (1u << 17)
+#define MSDC_INT_DMA_GPDCSERR   (1u << 18)
+#define MSDC_INT_DMA_PROTECT    (1u << 19)
+
+#define MSDC_DMA_CTRL_START     (1u << 0)
+#define MSDC_DMA_CTRL_STOP      (1u << 1)
+#define MSDC_DMA_CTRL_MODE      (1u << 8)
+#define MSDC_DMA_CTRL_LASTBUF   (1u << 10)
+#define MSDC_DMA_CTRL_BRUSTSZ   (0x7u << 12)
+#define MSDC_DMA_CFG_STS        (1u << 0)
+#define MSDC_DMA_CFG_DECSEN     (1u << 1)
+#define MSDC_BURST_64B          0x6
+#define DMA_ADDR_HIGH_4BIT      (0xfu << 0)
+
+#define MSDC_RESP_NONE          0x0
+#define MSDC_RESP_R1            0x1
+#define MSDC_RESP_R2            0x2
+#define MSDC_RESP_R3            0x3
+#define MSDC_RESP_R1B           0x7
+
+#define MSDC_DTYPE_NONE         0x0
+#define MSDC_DTYPE_SINGLE       (1u << 11)
+#define MSDC_DTYPE_MULTI        (2u << 11)
+#define MSDC_RW_WRITE           (1u << 13)
+#define MSDC_STOP_BIT           (1u << 14)
+#define MSDC_BLKLEN_SHIFT       16
+
+/* Command poll bounds: a 200 MHz card clock needs ~20 us for CMD13 including
+ * the response; 20 M register reads are seconds of headroom on any CPU. */
+#define MSDC_CMD_POLL           20000000u
+#define MSDC_BUSY_POLL          2000000u
+
+#define MSDC_BLOCK              512u
+#define BOUNCE_SIZE             (64u << 10)
+#define BOUNCE_BLOCKS           (BOUNCE_SIZE / MSDC_BLOCK)
+
+struct msdc_gpd {
+	uint32_t info;
+	uint32_t next;
+	uint32_t ptr;
+	uint32_t data_len;
+	uint32_t arg;
+	uint32_t blknum;
+	uint32_t cmd;
+};
+
+struct msdc_bd {
+	uint32_t info;
+	uint32_t next;
+	uint32_t ptr;
+	uint32_t data_len;
+};
+
+#define GPD_HWO                 (1u << 0)
+#define GPD_BDP                 (1u << 1)
+#define BD_EOL                  (1u << 0)
+
+/* Contiguous DMA allocation layout (one kmem_alloc_contig). */
+#define DMA_GPD                 0x0000
+#define DMA_BD                  0x0100
+#define DMA_BUF                 0x1000
+#define DMA_SIZE                (DMA_BUF + BOUNCE_SIZE)
+
+static struct {
+	vm_offset_t regs;
+	vm_offset_t dma;                /* kernel VA of the DMA allocation */
+	uint64_t dma_pa;
+	uint32_t secsize;
+	uint64_t first_lba;             /* partition start, 512-byte sectors */
+	uint64_t nsectors;              /* partition size, 512-byte sectors */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+	bool claimed;
+} md;
+
+static LCK_GRP_DECLARE(merlin_msdc_grp, "merlin_msdc");
+static LCK_MTX_DECLARE(merlin_msdc_lock, &merlin_msdc_grp);
+
+static inline uint32_t
+md_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(md.regs + off);
+}
+
+static inline void
+md_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(md.regs + off) = v;
+}
+
+static uint32_t
+md_checksum(const uint8_t *buf, unsigned len)
+{
+	uint32_t sum = 0;
+
+	for (unsigned i = 0; i < len; i++) {
+		sum += buf[i];
+	}
+	return 0xff - (sum & 0xff);
+}
+
+/*
+ * Poll MSDC_INT until one of mask is set. Returns 0 on success with the
+ * observed bits in *seen, ETIMEDOUT otherwise (with the last read in *seen).
+ */
+static int
+md_wait_int(uint32_t mask, uint32_t *seen)
+{
+	uint32_t v = 0;
+
+	for (uint32_t i = 0; i < MSDC_CMD_POLL; i++) {
+		v = md_rd(MSDC_INT);
+		if (v & mask) {
+			if (seen) {
+				*seen = v;
+			}
+			return 0;
+		}
+	}
+	if (seen) {
+		*seen = v;
+	}
+	return ETIMEDOUT;
+}
+
+static void
+md_int_clear(uint32_t bits)
+{
+	md_wr(MSDC_INT, bits);
+}
+
+/* Wait for the command/data engines to go idle. Iteration-bounded. */
+static int
+md_wait_idle(void)
+{
+	for (uint32_t i = 0; i < MSDC_BUSY_POLL; i++) {
+		if (!(md_rd(SDC_STS) & SDC_STS_CMDBUSY)) {
+			return 0;
+		}
+	}
+	return EBUSY;
+}
+
+/*
+ * One command without data. rawcmd is the SDC_CMD image (opcode, response
+ * type, block length and data-phase type). resp may be NULL; otherwise up to
+ * four response words (R2 fills all four, R1/R3/R6/R7 only resp[0]).
+ */
+static int
+md_command(uint32_t rawcmd, uint32_t arg, uint32_t nresp, uint32_t *resp)
+{
+	uint32_t seen = 0;
+	int error;
+
+	error = md_wait_idle();
+	if (error) {
+		printf("MERLIN MSDC: command engine busy (SDC_STS %08x)\n", md_rd(SDC_STS));
+		return error;
+	}
+	md_int_clear(0xffffffffu);
+	md_wr(SDC_ARG, arg);
+	md_wr(SDC_CMD, rawcmd);
+	error = md_wait_int(MSDC_INT_CMDRDY | MSDC_INT_CMDTMO | MSDC_INT_RSPCRCERR, &seen);
+	if (!error && (seen & (MSDC_INT_CMDTMO | MSDC_INT_RSPCRCERR))) {
+		error = (seen & MSDC_INT_CMDTMO) ? ETIMEDOUT : EIO;
+	}
+	if (nresp && resp) {
+		resp[0] = md_rd(SDC_RESP0);
+	}
+	if (nresp >= 4 && resp) {
+		resp[1] = md_rd(SDC_RESP1);
+		resp[2] = md_rd(SDC_RESP2);
+		resp[3] = md_rd(SDC_RESP3);
+	}
+	md_int_clear(seen ? seen : 0xffffffffu);
+	return error;
+}
+
+/*
+ * Read nblocks 512-byte sectors at lba into the bounce buffer through the
+ * controller's GPD/BD DMA. CMD17 for one block, CMD18 for several.
+ */
+static int
+md_read_sectors(uint64_t lba, uint32_t nblocks)
+{
+	struct msdc_gpd *gpd = (struct msdc_gpd *)(md.dma + DMA_GPD);
+	struct msdc_bd *bd = (struct msdc_bd *)(md.dma + DMA_BD);
+	uint64_t gpd_pa = md.dma_pa + DMA_GPD;
+	uint64_t bd_pa = md.dma_pa + DMA_BD;
+	uint64_t buf_pa = md.dma_pa + DMA_BUF;
+	uint32_t len = nblocks * MSDC_BLOCK;
+	uint32_t hi_next, hi_ptr, hi_buf;
+	uint32_t rawcmd, ctrl, seen = 0, dma_cfg;
+	uint32_t opcode;
+	int error;
+
+	if (nblocks == 0 || nblocks > BOUNCE_BLOCKS || lba > 0xffffffffull) {
+		return EINVAL;
+	}
+
+	hi_next = (uint32_t)((gpd_pa + sizeof(*gpd)) >> 32) & 0xf;
+	hi_ptr = (uint32_t)(bd_pa >> 32) & 0xf;
+	hi_buf = (uint32_t)(buf_pa >> 32) & 0xf;
+
+	bzero(gpd, 2 * sizeof(*gpd));
+	bzero(bd, 2 * sizeof(*bd));
+
+	/* Fill every field first: the checksum covers the first 16 bytes. */
+	gpd[0].info = GPD_HWO | GPD_BDP | (hi_next << 24) | (hi_ptr << 28);
+	gpd[0].next = (uint32_t)(gpd_pa + sizeof(*gpd));
+	gpd[0].ptr = (uint32_t)bd_pa;
+	gpd[0].data_len = 0;
+	gpd[0].info |= md_checksum((const uint8_t *)&gpd[0], 16) << 8;
+
+	bd[0].info = BD_EOL | (hi_buf << 28);
+	bd[0].next = 0;
+	bd[0].ptr = (uint32_t)buf_pa;
+	bd[0].data_len = len & 0xffff;
+	bd[0].info |= md_checksum((const uint8_t *)&bd[0], 16) << 8;
+
+	/* Descriptors and the destination buffer must be visible to the device. */
+	flush_dcache64(gpd_pa, 0x200, TRUE);
+	flush_dcache64(buf_pa, len, TRUE);
+
+	/* Always DMA, never the internal PIO FIFO path. */
+	md_wr(MSDC_CFG, md_rd(MSDC_CFG) & ~MSDC_CFG_PIO);
+	md_wr(SDC_BLK_NUM, nblocks);
+
+	opcode = (nblocks > 1) ? 18 : 17;
+	rawcmd = opcode | (MSDC_RESP_R1 << 7) |
+	    (((MSDC_BLOCK & 0xfff) << MSDC_BLKLEN_SHIFT)) |
+	    ((nblocks > 1) ? MSDC_DTYPE_MULTI : MSDC_DTYPE_SINGLE);
+
+	error = md_wait_idle();
+	if (error) {
+		printf("MERLIN MSDC: card busy before CMD%u (SDC_STS %08x)\n",
+		    opcode, md_rd(SDC_STS));
+		return error;
+	}
+	md_int_clear(0xffffffffu);
+	md_wr(SDC_ARG, (uint32_t)lba);
+	md_wr(SDC_CMD, rawcmd);
+
+	error = md_wait_int(MSDC_INT_CMDRDY | MSDC_INT_CMDTMO | MSDC_INT_RSPCRCERR, &seen);
+	if (error) {
+		printf("MERLIN MSDC: CMD%u no response (INT %08x)\n", opcode, seen);
+		return error;
+	}
+	if (seen & MSDC_INT_CMDTMO) {
+		printf("MERLIN MSDC: CMD%u timed out\n", opcode);
+		return ETIMEDOUT;
+	}
+	if (seen & MSDC_INT_RSPCRCERR) {
+		printf("MERLIN MSDC: CMD%u response CRC error\n", opcode);
+		return EIO;
+	}
+
+	/* The data phase was waiting for us: arm the descriptors now. */
+	dma_cfg = md_rd(MSDC_DMA_CFG);
+	md_wr(MSDC_DMA_CFG, dma_cfg | MSDC_DMA_CFG_DECSEN);
+	ctrl = md_rd(MSDC_DMA_CTRL);
+	ctrl &= ~(MSDC_DMA_CTRL_BRUSTSZ | MSDC_DMA_CTRL_MODE);
+	ctrl |= (MSDC_BURST_64B << 12) | MSDC_DMA_CTRL_MODE;
+	md_wr(MSDC_DMA_CTRL, ctrl);
+	md_wr(DMA_SA_H4BIT, (md_rd(DMA_SA_H4BIT) & ~DMA_ADDR_HIGH_4BIT) |
+	    ((uint32_t)(gpd_pa >> 32) & 0xf));
+	md_wr(MSDC_DMA_SA, (uint32_t)gpd_pa);
+	md_wr(MSDC_DMA_CTRL, ctrl | MSDC_DMA_CTRL_START);
+
+	error = md_wait_int(MSDC_INT_XFER_COMPL | MSDC_INT_DXFER_DONE |
+	    MSDC_INT_DATTMO | MSDC_INT_DATCRCERR | MSDC_INT_DMA_GPDCSERR |
+	    MSDC_INT_DMA_BDCSERR | MSDC_INT_DMA_PROTECT, &seen);
+	if (error) {
+		printf("MERLIN MSDC: CMD%u data phase stalled (INT %08x DMA_CFG %08x)\n",
+		    opcode, md_rd(MSDC_INT), md_rd(MSDC_DMA_CFG));
+	}
+	/* Stop the DMA engine and wait for it to acknowledge. */
+	md_wr(MSDC_DMA_CTRL, ctrl | MSDC_DMA_CTRL_STOP);
+	for (uint32_t i = 0; i < MSDC_BUSY_POLL; i++) {
+		if (!(md_rd(MSDC_DMA_CFG) & MSDC_DMA_CFG_STS)) {
+			break;
+		}
+	}
+	md_int_clear(seen ? seen : 0xffffffffu);
+	if (error) {
+		return error;
+	}
+	if (seen & (MSDC_INT_DATTMO | MSDC_INT_DATCRCERR)) {
+		printf("MERLIN MSDC: CMD%u data %s (INT %08x)\n", opcode,
+		    (seen & MSDC_INT_DATTMO) ? "timeout" : "CRC error", seen);
+		return (seen & MSDC_INT_DATTMO) ? ETIMEDOUT : EIO;
+	}
+	if (seen & (MSDC_INT_DMA_GPDCSERR | MSDC_INT_DMA_BDCSERR | MSDC_INT_DMA_PROTECT)) {
+		printf("MERLIN MSDC: CMD%u DMA descriptor error (INT %08x)\n", opcode, seen);
+		return EIO;
+	}
+	/* Invalidate what the device wrote before the CPU reads it. */
+	flush_dcache64(buf_pa, len, TRUE);
+	return 0;
+}
+
+/* Card status through CMD13; also proves the command path works at all. */
+static int
+md_card_status(uint32_t *status, uint32_t rca)
+{
+	uint32_t resp = 0;
+	int error = md_command(13 | (MSDC_RESP_R1 << 7), rca << 16, 1, &resp);
+
+	if (!error && status) {
+		*status = resp;
+	}
+	return error;
+}
+
+static int
+md_controller_start(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	uint32_t cfg, inten, ints, sdc_cfg;
+	int error;
+
+	if (md.claimed) {
+		return 0;
+	}
+	if (SecureDTLookupEntry(NULL, "/merlin-msdc", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("MERLIN MSDC: no /merlin-msdc node in the device tree\n");
+		return ENXIO;
+	}
+	md.regs = ml_io_map(reg[0], reg[1]);
+	if (!md.regs) {
+		printf("MERLIN MSDC: cannot map the controller\n");
+		return ENOMEM;
+	}
+
+	/* Take the interrupt path down: this driver polls. */
+	inten = md_rd(MSDC_INTEN);
+	md_wr(MSDC_INTEN, 0);
+	ints = md_rd(MSDC_INT);
+	md_int_clear(ints);
+
+	cfg = md_rd(MSDC_CFG);
+	sdc_cfg = md_rd(SDC_CFG);
+	printf("MERLIN MSDC: CFG %08x (ckstb %u ckmode %u ckdiv %u hs400 %u pio %u)\n",
+	    cfg, (cfg & MSDC_CFG_CKSTB) ? 1 : 0,
+	    (cfg & MSDC_CFG_CKMOD) >> 16, (cfg & MSDC_CFG_CKDIV) >> 8,
+	    (cfg & MSDC_CFG_HS400_CK_MODE) ? 1 : 0, (cfg & MSDC_CFG_PIO) ? 1 : 0);
+	printf("MERLIN MSDC: IOCON %08x PS %08x FIFOCS %08x SDC_CFG %08x (bus %u bits) SDC_STS %08x\n",
+	    md_rd(MSDC_IOCON), md_rd(MSDC_PS), md_rd(MSDC_FIFOCS), sdc_cfg,
+	    ((sdc_cfg & SDC_CFG_BUSWIDTH) >> 16) == 0 ? 1u :
+	    (((sdc_cfg & SDC_CFG_BUSWIDTH) >> 16) == 1 ? 4u : 8u), md_rd(SDC_STS));
+	printf("MERLIN MSDC: INTEN %08x saved, INT %08x cleared, DMA_CTRL %08x DMA_CFG %08x PATCH %08x %08x %08x\n",
+	    inten, ints, md_rd(MSDC_DMA_CTRL), md_rd(MSDC_DMA_CFG),
+	    md_rd(MSDC_PATCH_BIT), md_rd(MSDC_PATCH_BIT1), md_rd(MSDC_PATCH_BIT2));
+	if (!(cfg & MSDC_CFG_CKSTB)) {
+		printf("MERLIN MSDC: card clock is not stable (bootloader state lost)\n");
+		return ENXIO;
+	}
+
+	if (kmem_alloc_contig(kernel_map, &md.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("MERLIN MSDC: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)md.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	md.dma_pa = ptoa_64(pn);
+	md.secsize = MSDC_BLOCK;
+	md.claimed = true;
+
+	/* CMD13 on the bootloader's RCA (eMMC RCA is 1 for MTK LK). */
+	uint32_t status = 0;
+	error = md_card_status(&status, 1);
+	printf("MERLIN MSDC: CMD13 rca 1 -> %d, status %08x (state %u)\n",
+	    error, status, (status >> 9) & 0xf);
+	if (error) {
+		/* Some bootloaders hand over RCA 0 or 2; report, do not guess. */
+		for (uint32_t rca = 0; rca <= 2; rca++) {
+			uint32_t st = 0;
+			int e = md_card_status(&st, rca);
+			printf("MERLIN MSDC: CMD13 rca %u -> %d, status %08x (state %u)\n",
+			    rca, e, st, (st >> 9) & 0xf);
+			if (!e && ((st >> 9) & 0xf) != 0) {
+				error = 0;
+				status = st;
+				break;
+			}
+		}
+	}
+	if (error) {
+		printf("MERLIN MSDC: card does not answer any RCA; full re-init needed\n");
+		return ENXIO;
+	}
+	return 0;
+}
+
+static int
+md_find_partition(const char *want)
+{
+	const uint8_t *b = (const uint8_t *)(md.dma + DMA_BUF);
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	int error;
+
+	/* CMD16: block length 512, then read LBA 1 (the GPT header). */
+	error = md_command(16 | (MSDC_RESP_R1 << 7), MSDC_BLOCK, 1, NULL);
+	if (error) {
+		printf("MERLIN MSDC: CMD16 (set block length) failed: %d\n", error);
+		return error;
+	}
+	error = md_read_sectors(1, 1);
+	if (error) {
+		printf("MERLIN MSDC: GPT header read failed: %d\n", error);
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("MERLIN MSDC: no GPT signature at LBA 1 (saw %02x %02x %02x %02x %02x %02x %02x %02x)\n",
+		    b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]);
+		return ENXIO;
+	}
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	printf("MERLIN MSDC: GPT ok, %u entries of %u bytes at LBA %llu\n",
+	    nent, esz, entry_lba);
+	if (esz != 128 || nent == 0 || nent > 256) {
+		printf("MERLIN MSDC: unsupported GPT entry table\n");
+		return ENXIO;
+	}
+	uint32_t blocks = (nent * esz + MSDC_BLOCK - 1) / MSDC_BLOCK;
+	error = md_read_sectors(entry_lba, blocks);
+	if (error) {
+		printf("MERLIN MSDC: GPT entry table read failed: %d\n", error);
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (name[0] == 0) {
+			continue;
+		}
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		printf("MERLIN MSDC:   part %u \"%s\" lba %llu..%llu (%llu MiB)\n",
+		    i, name, first, last,
+		    (last >= first) ? ((last - first + 1) >> 11) : 0);
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		if (last < first) {
+			return ENXIO;
+		}
+		md.first_lba = first;
+		md.nsectors = last - first + 1;
+		return 0;
+	}
+	printf("MERLIN MSDC: no GPT partition named \"%s\"\n", want);
+	return ENOENT;
+}
+
+static int
+merlin_msdc_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!md.ready) {
+		return ENXIO;
+	}
+	return (flags & FWRITE) ? EROFS : 0;
+}
+
+static int
+merlin_msdc_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+merlin_msdc_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * md.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = md.nsectors * MSDC_BLOCK;
+
+	buf_setresid(bp, count);
+	if (!(buf_flags(bp) & B_READ)) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&merlin_msdc_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint64_t lba = md.first_lba + pos / MSDC_BLOCK;
+		uint32_t skip = (uint32_t)(pos % MSDC_BLOCK);
+		uint32_t want = MIN(count - done, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + MSDC_BLOCK - 1) / MSDC_BLOCK;
+
+		error = md_read_sectors(lba, blocks);
+		if (error) {
+			break;
+		}
+		memcpy(vaddr + done, (const void *)(md.dma + DMA_BUF + skip), want);
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&merlin_msdc_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+merlin_msdc_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = md.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > MSDC_BLOCK || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		md.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = MSDC_BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = md.nsectors * MSDC_BLOCK / md.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = 0;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = BOUNCE_SIZE / md.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+merlin_msdc_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return merlin_msdc_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+merlin_msdc_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return merlin_msdc_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+merlin_msdc_psize(__unused dev_t dev)
+{
+	return md.ready ? (int)MIN(md.nsectors * MSDC_BLOCK / md.secsize, INT_MAX) : -1;
+}
+
+static int
+merlin_msdc_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(merlin_msdc_strategy, NULL, dev, B_READ, minphys, uio, (int)md.secsize);
+}
+
+static int
+merlin_msdc_write(__unused dev_t dev, __unused struct uio *uio, __unused int ioflag)
+{
+	return EROFS;
+}
+
+static const struct bdevsw merlin_msdc_bdevsw = {
+	.d_open     = merlin_msdc_open,
+	.d_close    = merlin_msdc_close,
+	.d_strategy = merlin_msdc_strategy,
+	.d_ioctl    = merlin_msdc_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = merlin_msdc_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw merlin_msdc_cdevsw = {
+	.d_open       = merlin_msdc_open,
+	.d_close      = merlin_msdc_close,
+	.d_read       = merlin_msdc_read,
+	.d_write      = merlin_msdc_write,
+	.d_ioctl      = merlin_msdc_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+merlin_msdc_attach(void)
+{
+	char want[64] = "userdata";
+	int error;
+
+	PE_parse_boot_argn("msdcroot", want, sizeof(want));
+
+	lck_mtx_lock(&merlin_msdc_lock);
+	error = md_controller_start();
+	if (!error) {
+		error = md_find_partition(want);
+	}
+	lck_mtx_unlock(&merlin_msdc_lock);
+	if (error) {
+		return error;
+	}
+
+	md.bmajor = bdevsw_add(-1, &merlin_msdc_bdevsw);
+	if (md.bmajor < 0) {
+		return ENXIO;
+	}
+	md.cmajor = cdevsw_add_with_bdev(-1, &merlin_msdc_cdevsw, md.bmajor);
+	if (md.cmajor < 0) {
+		return ENXIO;
+	}
+	md.bdev = makedev(md.bmajor, 0);
+	devfs_make_node(md.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "msdcroot0");
+	devfs_make_node(makedev(md.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rmsdcroot0");
+	md.ready = true;
+	printf("MERLIN MSDC: \"%s\" at LBA %llu, %llu MiB, read-only; /dev/msdcroot0\n",
+	    want, md.first_lba, md.nsectors >> 11);
+	return 0;
+}
+
+/* Diagnostic run for msdcprobe=1: log, read, and leave the controller as is. */
+int merlin_msdc_probe(void);
+
+int
+merlin_msdc_probe(void)
+{
+	lck_mtx_lock(&merlin_msdc_lock);
+	int error = md_controller_start();
+	if (!error) {
+		error = md_command(16 | (MSDC_RESP_R1 << 7), MSDC_BLOCK, 1, NULL);
+		printf("MERLIN MSDC: CMD16 (block length 512) -> %d\n", error);
+	}
+	if (!error) {
+		error = md_read_sectors(0, 1);
+		const uint8_t *b = (const uint8_t *)(md.dma + DMA_BUF);
+		printf("MERLIN MSDC: LBA0 read -> %d, %02x %02x %02x %02x %02x %02x %02x %02x  %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    error, b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7],
+		    b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15]);
+	}
+	if (!error) {
+		error = md_find_partition("userdata");
+		printf("MERLIN MSDC: userdata lookup -> %d\n", error);
+	}
+	lck_mtx_unlock(&merlin_msdc_lock);
+	return error;
+}
+
+/* Root device for rd=msdcroot0 (checked before IOFindBSDRoot's gIOBSD wait). */
+int merlin_msdc_rootdev(dev_t *dev);
+
+int
+merlin_msdc_rootdev(dev_t *dev)
+{
+	if (!md.ready) {
+		int error = merlin_msdc_attach();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = md.bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
